{
  "name": "importou-platform-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema src/infra/database/@prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/infra/database/@prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema src/infra/database/@prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema src/infra/database/@prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema src/infra/database/@prisma/schema.prisma"
  },
  "prisma": {
    "schema": "src/infra/database/@prisma/schema.prisma",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/infra/database/seeds/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.16.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeid-js": "^1.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "prisma": "^6.16.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
